{
  "name": "fjcpc-teps-workspace",
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm backend:build && pnpm frontend:build",
    "db:migrate": "pnpm --filter ./backend run migration:run",
    "db:migrate:revert": "pnpm --filter ./backend run migration:revert",
    "deploy:dist": "node scripts/build-dist.mjs",
    "backend:dev": "pnpm --filter ./backend run dev",
    "backend:start": "pnpm --filter ./backend run start",
    "backend:build": "pnpm --filter ./backend run build",
    "backend:test": "pnpm --filter ./backend run test",
    "backend:lint": "pnpm --filter ./backend run lint",
    "backend:format": "pnpm --filter ./backend run format",
    "frontend:dev": "pnpm --filter ./frontend run dev",
    "frontend:build": "pnpm --filter ./frontend run build",
    "frontend:type-check": "pnpm --filter ./frontend run type-check",
    "frontend:lint": "pnpm --filter ./frontend run lint",
    "frontend:format": "pnpm --filter ./frontend run format"
  },
  "packageManager": "pnpm@11.24.0"
}
